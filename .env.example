# Discord AI Voicebot Environment Variables
# Copy this file to .env and fill in your actual values

# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# LLM backend
LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio

# TTS backend
TTS_PROVIDER=inworld
INWORLD_TTS_API_KEY=your_inworld_base64_api_key_here
INWORLD_TTS_VOICE_ID=Dennis
INWORLD_TTS_MODEL_ID=inworld-tts-1.5-max
INWORLD_TTS_SAMPLE_RATE_HZ=48000
INWORLD_TTS_BUFFER_CHAR_THRESHOLD=40
INWORLD_TTS_AUTO_MODE=true
